{
  "name": "@calebduren/typograph",
  "version": "2.0.0-next.1",
  "description": "Considered typography for the web. Principles, reading styles, and inspectable punctuation.",
  "type": "module",
  "license": "MIT",
  "author": "Caleb Durenberger (https://calebduren.com)",
  "homepage": "https://typograph.dev",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "prose.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "typeset.css",
    "typography.css",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./remark": {
      "import": {
        "types": "./dist/remark.d.ts",
        "default": "./dist/remark.js"
      },
      "require": {
        "types": "./dist/remark.d.cts",
        "default": "./dist/remark.cjs"
      }
    },
    "./rehype": {
      "import": {
        "types": "./dist/rehype.d.ts",
        "default": "./dist/rehype.js"
      },
      "require": {
        "types": "./dist/rehype.d.cts",
        "default": "./dist/rehype.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/stream.d.ts",
        "default": "./dist/stream.js"
      },
      "require": {
        "types": "./dist/stream.d.cts",
        "default": "./dist/stream.cjs"
      }
    },
    "./prose.css": "./prose.css",
    "./typography": {
      "import": {
        "types": "./dist/typography.d.ts",
        "default": "./dist/typography.js"
      },
      "require": {
        "types": "./dist/typography.d.cts",
        "default": "./dist/typography.cjs"
      }
    },
    "./principles": {
      "import": {
        "types": "./dist/principles.d.ts",
        "default": "./dist/principles.js"
      },
      "require": {
        "types": "./dist/principles.d.cts",
        "default": "./dist/principles.cjs"
      }
    },
    "./typography.css": "./typography.css",
    "./typeset.css": "./typeset.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/remark.ts src/rehype.ts src/stream.ts src/typography.ts src/principles.ts --format esm,cjs --dts --minify --clean"
  },
  "keywords": [
    "typography",
    "smart-quotes",
    "ai",
    "streaming",
    "remark-plugin",
    "rehype-plugin"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calebduren/typograph.git",
    "directory": "packages/typograph"
  },
  "bugs": {
    "url": "https://github.com/calebduren/typograph/issues"
  }
}
