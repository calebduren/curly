{
  "name": "cowboy-curly",
  "version": "1.0.1",
  "description": "Thoughtful, inspectable typography for prose and AI interfaces. By Cowboy.",
  "type": "module",
  "license": "MIT",
  "author": "Caleb Durenberger (https://calebduren.com)",
  "homepage": "https://cowboy.is/curly/",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "prose.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./remark": {
      "import": {
        "types": "./dist/remark.d.ts",
        "default": "./dist/remark.js"
      },
      "require": {
        "types": "./dist/remark.d.cts",
        "default": "./dist/remark.cjs"
      }
    },
    "./rehype": {
      "import": {
        "types": "./dist/rehype.d.ts",
        "default": "./dist/rehype.js"
      },
      "require": {
        "types": "./dist/rehype.d.cts",
        "default": "./dist/rehype.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/stream.d.ts",
        "default": "./dist/stream.js"
      },
      "require": {
        "types": "./dist/stream.d.cts",
        "default": "./dist/stream.cjs"
      }
    },
    "./prose.css": "./prose.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/remark.ts src/rehype.ts src/stream.ts --format esm,cjs --dts --minify --clean"
  },
  "keywords": [
    "typography",
    "smart-quotes",
    "ai",
    "streaming",
    "remark-plugin",
    "rehype-plugin"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calebduren/curly.git",
    "directory": "packages/curly"
  },
  "bugs": {
    "url": "https://github.com/calebduren/curly/issues"
  }
}
